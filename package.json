{
  "name": "livedoc-sync",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered GitHub documentation sync tool",
  "scripts": {
    "dev": "pnpm --filter @livedoc-sync/shared build && pnpm --filter \"./apps/**\" dev",
    "build": "pnpm --filter \"./apps/**\" --filter \"./packages/**\" build",
    "lint": "pnpm --filter \"./apps/**\" --filter \"./packages/**\" lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @livedoc-sync/shared db:generate",
    "db:migrate": "pnpm --filter @livedoc-sync/shared db:migrate",
    "db:studio": "pnpm --filter @livedoc-sync/shared db:studio"
  },
  "devDependencies": {
    "@types/node": "^20.19.31",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}