# ===========================================
# GENERAL
# ===========================================
NODE_ENV=development

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://livedoc:livedoc_dev_password@localhost:5432/livedoc_sync

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ===========================================
# API SERVER
# ===========================================
API_PORT=3001
API_HOST=0.0.0.0

# ===========================================
# GITHUB APP
# ===========================================
GITHUB_APP_ID=your_app_id_here
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYour private key here\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app-name/installations/new

# ===========================================
# GITHUB OAUTH (for web login)
# ===========================================
GITHUB_CLIENT_ID=your_oauth_client_id
GITHUB_CLIENT_SECRET=your_oauth_client_secret

# ===========================================
# NEXTAUTH (for web)
# ===========================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_minimum_32_chars

# ===========================================
# LLM PROVIDER
# ===========================================
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4-turbo-preview
